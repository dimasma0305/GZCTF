FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETPLATFORM
WORKDIR /src

# Install Node.js 22 and pnpm
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g pnpm@10.33.0

# Copy solution and configuration files
COPY global.json Directory.Packages.props GZCTF.slnx ./

# Copy project files (retaining directory structure)
COPY GZCTF/GZCTF.csproj ./GZCTF/
COPY GZCTF.AppHost/GZCTF.AppHost.csproj ./GZCTF.AppHost/
COPY GZCTF.Test/GZCTF.Test.csproj ./GZCTF.Test/
COPY GZCTF.Integration.Test/GZCTF.Integration.Test.csproj ./GZCTF.Integration.Test/

# Restore .NET dependencies
RUN dotnet restore

# Copy frontend configuration
COPY GZCTF/ClientApp/package.json GZCTF/ClientApp/pnpm-lock.yaml GZCTF/ClientApp/pnpm-workspace.yaml ./GZCTF/ClientApp/

# Install frontend dependencies (cached layer)
WORKDIR /src/GZCTF/ClientApp
RUN pnpm install

# Copy the rest of the source code
WORKDIR /src
COPY . .

# Publish (will use cached frontend node_modules)
WORKDIR /src/GZCTF
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Debian/glibc, not Alpine/musl: this process P/Invokes into native libpcap
# (SharpPcap, A&D traffic capture — ContainerProvider:EnableTrafficCapture),
# ICU, libgdiplus and krb5, and a native SIGSEGV inside musl's vfscanf took
# the platform down for ~55min with no stack trace to go on. glibc's libc is
# far more battle-tested for this kind of native interop. ICU and tzdata are
# already bundled in this base image, unlike the Alpine variant.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080

ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    LC_ALL=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget libpcap0.8t64 ca-certificates libgdiplus libkrb5-3 git openssh-client && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

HEALTHCHECK --interval=5m --timeout=3s --start-period=10s --retries=1 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/healthz || exit 1

ENTRYPOINT ["dotnet", "GZCTF.dll"]
